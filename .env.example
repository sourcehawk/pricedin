# Copy this file to .env and change what you need. Docker Compose and the
# Makefile read .env. Never commit .env.

# --- Docker Compose: Postgres ---
# Credentials of the local database. Compose passes them to the server as
# PRICEDIN_DATABASE_ parts, which need no URL encoding. In this file, put a
# value with a space followed by # in single quotes.
POSTGRES_USER=pricedin
POSTGRES_PASSWORD=pricedin
POSTGRES_DB=pricedin

# --- Docker Compose: host ports ---
# Change these when another program on your machine uses the port.
PRICEDIN_WEB_PORT=3000
PRICEDIN_API_PORT=8080
PRICEDIN_METRICS_PORT=9090
PRICEDIN_DB_PORT=5432

# --- Docker Compose: images ---
# Names of the server and web images. The Makefile sets them for `make up`
# and `make test-e2e`, by default from IMAGE_TAG (default dev).
# PRICEDIN_SERVER_IMAGE=pricedin-server:dev
# PRICEDIN_WEB_IMAGE=pricedin-web:dev
# Image of the fixture server, which docker-compose.fixtures.yml runs.
# PRICEDIN_FIXTURES_IMAGE=pricedin-fixtures:dev
# Compose project of the fixture stack (make up-fixtures), apart from the
# project of make up so that the two never share volumes.
# PRICEDIN_FIXTURES_PROJECT=pricedin-fixtures

# --- Server: HTTP ---
# Listen address of the API (host:port). Compose sets it to :8080 in the container.
PRICEDIN_HTTP_ADDR=:8080
# Listen address of the Prometheus /metrics endpoint. Must differ from the API address.
PRICEDIN_METRICS_ADDR=:9090

# --- Server: database ---
# `pricedin serve` needs one of two forms. Do not set both.
# Form 1: one connection URL. Encode special characters in the user and the
# password (for example, # becomes %23). Compose overrides it to reach the db
# service; this value is for a server that runs on your host.
PRICEDIN_DATABASE_URL=postgres://pricedin:pricedin@localhost:5432/pricedin?sslmode=disable
# Form 2: the parts. They need no encoding. Compose sets them for its server;
# it takes the user, the password and the name from the POSTGRES_ values above.
# Host name or address of Postgres. Required in form 2.
# PRICEDIN_DATABASE_HOST=localhost
# Port. Default 5432.
# PRICEDIN_DATABASE_PORT=5432
# User name, and its password. A password needs a user.
# PRICEDIN_DATABASE_USER=pricedin
# PRICEDIN_DATABASE_PASSWORD=pricedin
# Database name.
# PRICEDIN_DATABASE_NAME=pricedin
# disable, allow, prefer, require, verify-ca or verify-full. Default: the pgx default (prefer).
# PRICEDIN_DATABASE_SSLMODE=disable
# Connection of the ingestion jobs' advisory locks. Default: the database
# connection above. The locks hold a session, so this must be a direct
# connection, not a pooler in transaction mode (such as a Neon -pooler host or
# Supabase port 6543); the jobs refuse to start otherwise. A process that runs
# jobs uses up to 12 connections here, besides at least 8 for its queries.
# PRICEDIN_DATABASE_LOCK_URL=postgres://pricedin:pricedin@localhost:5432/pricedin?sslmode=disable
# Connection of `pricedin migrate`. Default: the database connection above.
# In production, the server and the jobs connect as a role that owns no
# table (deploy/sql/roles.sql), and this URL names the role that owns them.
# PRICEDIN_DATABASE_MIGRATE_URL=postgres://pricedin:pricedin@localhost:5432/pricedin?sslmode=disable

# --- Server: logging ---
# Lowest level written: debug, info, warn or error.
PRICEDIN_LOG_LEVEL=info
# json for machines, text for people.
PRICEDIN_LOG_FORMAT=json

# --- Web ---
# Base URL of the API, as the web server sees it. Compose sets http://server:8080.
PRICEDIN_API_URL=http://localhost:8080
# The same value as PRICEDIN_PROXY_SECRET of the server. The web server
# reads it at run time and sends it to the API only, never to the browser.
# Set it only on Vercel: the web app sends the address from the x-real-ip
# header, and only Vercel's edge sets that header so that a browser cannot
# choose it. Unset means that API calls carry no address of their own.
# PRICEDIN_PROXY_SECRET=

# --- End-to-end tests ---
# `make test-e2e` runs its own Compose project with its own host ports, so it
# never touches the stack of `make up`. The Makefile derives the URLs from
# the ports. Set a value here only to change it.
# PRICEDIN_E2E_PROJECT=pricedin-e2e
# PRICEDIN_E2E_WEB_PORT=3100
# PRICEDIN_E2E_API_PORT=8180
# PRICEDIN_E2E_METRICS_PORT=9190
# PRICEDIN_E2E_DB_PORT=5532
# Where Playwright finds the web app and the API.
# PRICEDIN_E2E_BASE_URL=http://localhost:3100
# PRICEDIN_E2E_API_URL=http://localhost:8180
# The file of variables that every Compose service reads in place of .env.
# scripts/e2e.sh sets /dev/null, so that the test stack ignores this file.
# PRICEDIN_ENV_FILE=.env

# --- Server: SEC EDGAR ---
# User-Agent for SEC requests: a name and a contact email address. SEC rejects
# requests without them. Required by every command that calls SEC.
# PRICEDIN_SEC_USER_AGENT=PricedIn you@example.com
# Base URLs of www.sec.gov and data.sec.gov. Change them only to use a fixture server.
PRICEDIN_SEC_BASE_URL=https://www.sec.gov
PRICEDIN_SEC_DATA_BASE_URL=https://data.sec.gov

# --- Prices: Massive (formerly Polygon.io) ---
# API key of the price provider. Required only by the commands that fetch
# prices, such as `pricedin prices verify` and the price jobs. Never commit it.
PRICEDIN_MASSIVE_API_KEY=
# Base URL of the API. Point it at a fixture server for offline tests.
PRICEDIN_MASSIVE_BASE_URL=https://api.massive.com
# Most requests a second that PricedIn sends to the API.
PRICEDIN_MASSIVE_RATE_LIMIT=20

# --- Ingestion jobs and the scheduler ---
# `pricedin serve` also loads a company on demand (POST
# /api/v1/stocks/{ticker}/load) with these settings and those of SEC,
# Massive and the blob store. Without the SEC user agent or the Massive key,
# that endpoint answers 501.
# Narrows the covered universe (every company with a current NYSE or Nasdaq
# ticker) to these comma-separated tickers, for development and tests. Empty
# means the whole universe.
# PRICEDIN_UNIVERSE=NVDA,AAPL,KO,GRMN,ADM
# Most trading days that prices-backfill loads, counted back from the last
# finished session. Default 1260, about five years.
# PRICEDIN_PRICES_BACKFILL_DAYS=1260
# UTC time of day, as HH:MM, at which `pricedin scheduler` runs the daily job.
# The default is after the US close, in summer and in winter.
# PRICEDIN_SCHEDULE_DAILY=01:30

# --- Server: authentication ---
# The owner's login email. Set it and the hash together; without them no
# login succeeds and only API tokens (`pricedin auth token create`) work.
# PRICEDIN_OWNER_EMAIL=you@example.com
# Argon2id hash of the owner's password, from `pricedin auth hash-password`.
# Put it in single quotes: it holds $ characters.
# PRICEDIN_OWNER_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# How long a login lasts, as a Go duration. Default 720h (30 days).
# PRICEDIN_SESSION_TTL=720h
# false drops the Secure flag of the session cookie, for a stack on plain
# http other than localhost. Default true.
# PRICEDIN_COOKIE_SECURE=true
# The web app's origins, comma-separated. A login, and a POST with the
# session cookie, must come from one of them. Compose sets
# http://localhost:<PRICEDIN_WEB_PORT>.
# PRICEDIN_PUBLIC_ORIGIN=https://pricedin.example.com
# Where the login rate limit finds the client address. Unset means the
# address of the connection, which behind a proxy is the proxy's.
# PRICEDIN_TRUSTED_PROXY_HEADER names a header that the proxies in front of
# the server always set. In a list header such as X-Forwarded-For, each
# proxy appends one entry, and PRICEDIN_TRUSTED_PROXY_HOPS (default 1) is
# the number of trusted proxies: the client is that many entries from the
# right. A wrong count makes every login share one limit, or lets a client
# choose its own address.
# On Fly.io, use Fly-Client-IP and 1. The Fly proxy sets that header to the
# address that it accepted the connection from.
# PRICEDIN_TRUSTED_PROXY_HEADER=Fly-Client-IP
# PRICEDIN_TRUSTED_PROXY_HOPS=1
# The secret that the web app sends with each API call, together with the
# browser's address (headers X-PricedIn-Proxy and X-PricedIn-Client-IP).
# The server uses that address only when the secret matches. Other calls,
# such as scripts with an API token, use the header above. Set the same
# value on the server and on the web app (see "Web"). At least 32
# printable ASCII characters without spaces: `openssl rand -hex 32`.
# Unset means that the server ignores both headers.
# Migration: an earlier setup used X-Forwarded-For and 2 behind Vercel. A
# client that calls the Fly host directly can forge that header. Change to
# Fly-Client-IP and 1, and set PRICEDIN_PROXY_SECRET on both sides.
# PRICEDIN_PROXY_SECRET=

# --- Server: blob storage ---
# Where raw downloads (SEC files, price responses) are kept: fs or s3.
PRICEDIN_BLOB_BACKEND=fs
# Folder of the fs backend. Compose sets /data/blob on a named volume.
PRICEDIN_BLOB_DIR=./data/blob
# Settings of the s3 backend: an S3 bucket or an S3-compatible service,
# such as Tigris or Cloudflare R2. Bucket and region are required for s3.
# PRICEDIN_BLOB_S3_BUCKET=pricedin-raw
# Base URL of an S3-compatible service; leave it unset for AWS S3.
# PRICEDIN_BLOB_S3_ENDPOINT=https://fly.storage.tigris.dev
# PRICEDIN_BLOB_S3_REGION=auto
# Set both keys, or neither to use the AWS default credential chain.
# PRICEDIN_BLOB_S3_ACCESS_KEY_ID=
# PRICEDIN_BLOB_S3_SECRET_ACCESS_KEY=
# true puts the bucket in the URL path, which some S3-compatible services need.
# PRICEDIN_BLOB_S3_PATH_STYLE=false
