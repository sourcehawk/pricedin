# Copy this file to .env and change what you need. Docker Compose and the
# Makefile read .env. Never commit .env.

# --- Docker Compose: Postgres ---
# Credentials of the local database. Compose passes them to the server as
# PRICEDIN_DATABASE_ parts, which need no URL encoding. In this file, put a
# value with a space followed by # in single quotes.
POSTGRES_USER=pricedin
POSTGRES_PASSWORD=pricedin
POSTGRES_DB=pricedin

# --- Docker Compose: host ports ---
# Change these when another program on your machine uses the port.
PRICEDIN_WEB_PORT=3000
PRICEDIN_API_PORT=8080
PRICEDIN_METRICS_PORT=9090
PRICEDIN_DB_PORT=5432

# --- Docker Compose: images ---
# Names of the server and web images. The Makefile sets them from IMAGE_TAG
# (default dev) for `make up` and `make test-e2e`.
# PRICEDIN_SERVER_IMAGE=pricedin-server:dev
# PRICEDIN_WEB_IMAGE=pricedin-web:dev

# --- Server: HTTP ---
# Listen address of the API (host:port). Compose sets it to :8080 in the container.
PRICEDIN_HTTP_ADDR=:8080
# Listen address of the Prometheus /metrics endpoint. Must differ from the API address.
PRICEDIN_METRICS_ADDR=:9090

# --- Server: database ---
# `pricedin serve` needs one of two forms. Do not set both.
# Form 1: one connection URL. Encode special characters in the user and the
# password (for example, # becomes %23). Compose overrides it to reach the db
# service; this value is for a server that runs on your host.
PRICEDIN_DATABASE_URL=postgres://pricedin:pricedin@localhost:5432/pricedin?sslmode=disable
# Form 2: the parts. They need no encoding. Compose sets them for its server;
# it takes the user, the password and the name from the POSTGRES_ values above.
# Host name or address of Postgres. Required in form 2.
# PRICEDIN_DATABASE_HOST=localhost
# Port. Default 5432.
# PRICEDIN_DATABASE_PORT=5432
# User name, and its password. A password needs a user.
# PRICEDIN_DATABASE_USER=pricedin
# PRICEDIN_DATABASE_PASSWORD=pricedin
# Database name.
# PRICEDIN_DATABASE_NAME=pricedin
# disable, allow, prefer, require, verify-ca or verify-full. Default: the pgx default (prefer).
# PRICEDIN_DATABASE_SSLMODE=disable

# --- Server: logging ---
# Lowest level written: debug, info, warn or error.
PRICEDIN_LOG_LEVEL=info
# json for machines, text for people.
PRICEDIN_LOG_FORMAT=json

# --- Web ---
# Base URL of the API, as the web server sees it. Compose sets http://server:8080.
PRICEDIN_API_URL=http://localhost:8080

# --- End-to-end tests ---
# `make test-e2e` runs its own Compose project with its own host ports, so it
# never touches the stack of `make up`. The Makefile derives the URLs from
# the ports. Set a value here only to change it.
# PRICEDIN_E2E_PROJECT=pricedin-e2e
# PRICEDIN_E2E_WEB_PORT=3100
# PRICEDIN_E2E_API_PORT=8180
# PRICEDIN_E2E_METRICS_PORT=9190
# PRICEDIN_E2E_DB_PORT=5532
# Where Playwright finds the web app and the API.
# PRICEDIN_E2E_BASE_URL=http://localhost:3100
# PRICEDIN_E2E_API_URL=http://localhost:8180

# --- Later: SEC (added with the SEC client) ---
# User-Agent for SEC requests, with a contact address. SEC rejects requests without one.
# PRICEDIN_SEC_USER_AGENT=PricedIn you@example.com

# --- Later: prices (added with the Massive adapter) ---
# API key of the Massive (formerly Polygon.io) price provider.
# PRICEDIN_MASSIVE_API_KEY=

# --- Later: authentication (added with the HTTP API) ---
# The owner's login email.
# PRICEDIN_OWNER_EMAIL=you@example.com
# Argon2id hash of the owner's password, from `pricedin auth hash-password`.
# PRICEDIN_OWNER_PASSWORD_HASH=

# --- Later: blob storage (added with the store) ---
# Local folder for raw downloads.
# PRICEDIN_BLOB_DIR=./data/blob
